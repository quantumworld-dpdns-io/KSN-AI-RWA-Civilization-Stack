{
  "name": "@aks/agent",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/runner.ts",
    "start:once": "tsx src/runner.ts --once",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aks/core": "workspace:*",
    "@mysten/sui": "^1.28.2",
    "openai": "^4.104.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
