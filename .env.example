# Environment Variables — copy to .env and fill in real values (never commit .env).
NODE_ENV=development

# Oracle Settings
ORACLE_PORT=8787
# Required: HMAC key for telemetry signing (>=16 chars). No default in non-test envs.
ORACLE_SIGNING_SECRET=__replace_me__
# Required to enable state-mutating oracle routes (>=16 chars in production).
ORACLE_API_KEY=__replace_me__

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=__replace_me__

# Postgres Settings
POSTGRES_USER=aks
POSTGRES_PASSWORD=__replace_me__
POSTGRES_DB=telemetry
DATABASE_URL=postgresql://aks:__replace_me__@localhost:5432/telemetry

# JWT Settings
JWT_SECRET=__replace_me__
API_KEY=__replace_me__

# Web Settings
VITE_ORACLE_URL=http://localhost:8787
